# Global password used for login (no user accounts, single shared password)
PASSWORD=akshar

# Postgres connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/akshar?schema=public

# Maalgaadi file storage middleware
NEXT_PUBLIC_MAALGAADI_ENDPOINT=https://maalgaadi-cdn.kacker.net
NEXT_PUBLIC_MAALGAADI_API_ENDPOINT=https://maalgaadi.kacker.net
MAALGAADI_API_KEY=maalgaadi
